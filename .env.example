# ============================================
# LLM CONFIGURATION (REQUIRED)
# ============================================
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ============================================
# PLANE CONFIGURATION (REQUIRED)
# ============================================
PLANE_URL=http://localhost:3000
PLANE_API_KEY=your-plane-api-key
PLANE_WORKSPACE_ID=your-workspace-id

# ============================================
# REVOLT CONFIGURATION (Human-in-the-Loop)
# ============================================
REVOLT_URL=http://localhost:8080
REVOLT_BOT_TOKEN=your-revolt-bot-token
REVOLT_ADMIN_USER_ID=your-user-id

# ============================================
# BOOKSTACK CONFIGURATION (REQUIRED)
# ============================================
BOOKSTACK_URL=http://localhost:6875
BOOKSTACK_API_TOKEN=your-bookstack-api-token

# ============================================
# CONTEXT7 CONFIGURATION (Tech Research)
# ============================================
CONTEXT7_API_KEY=your-context7-api-key

# ============================================
# WORKER CONFIGURATION
# ============================================
WORKER_IMAGE=turing-worker-base:latest
WORKER_TIMEOUT_MINUTES=15
ZOMBIE_CHECK_INTERVAL_MINUTES=5
MAX_WORKERS=5
EXECUTION_MODE=sequential

# ============================================
# GITHUB CONFIGURATION (Doctor Bug Reports)
# ============================================
GITHUB_REPO=louisphamdev/turing-os
GITHUB_ISSUE_URL=https://github.com/louisphamdev/turing-os/issues/new

# ============================================
# ADMIN CONFIGURATION
# ============================================
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ============================================
# DOCKER CONFIGURATION
# ============================================
DOCKER_HOST=unix:///var/run/docker.sock

# ============================================
# CUSTOM PORTS (Override default ports)
# ============================================
# Uncomment and set custom ports if needed
# PLANE_API_PORT=3000
# PLANE_WEB_PORT=80
# BOOKSTACK_PORT=6875
# REVOLT_PORT=8080
# ORCHESTRATOR_PORT=3001