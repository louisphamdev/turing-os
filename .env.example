# ============================================
# LLM CONFIGURATION (required unless using Ollama)
# ============================================
# Provider options: openai, anthropic, minimax, ollama, custom
# For Ollama, LLM_API_KEY can be left blank.
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# MiniMax Example:
# LLM_PROVIDER=minimax
# LLM_API_KEY=your-minimax-api-key
# LLM_MODEL=Codex-MiniMax-M2.7

# Ollama Example:
# LLM_PROVIDER=ollama
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# ============================================
# PLANE CE CONFIGURATION (ticket / user-story backend)
# ============================================
# After `docker compose up`, open http://localhost:9000 to finish onboarding:
#   1. Create the workspace below.
#   2. Create the project; copy its UUID into PLANE_PROJECT_ID.
#   3. Generate an API token in Profile -> API Tokens; paste into PLANE_API_TOKEN.
STATE_BACKEND=plane
PLANE_API_URL=http://turing_plane_api:8000/api/v1
PLANE_API_TOKEN=
PLANE_WORKSPACE_SLUG=turing
PLANE_PROJECT_ID=

PLANE_DB=plane
PLANE_DB_USER=plane
# Strong password REQUIRED. Compose fails to start if unset/empty.
# Generate with:  openssl rand -hex 32   (PowerShell: use the same openssl command)
PLANE_DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
# Django SECRET_KEY for Plane. REQUIRED. Compose fails to start if unset/empty.
# Generate with:  openssl rand -hex 32
PLANE_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# RabbitMQ password for Plane's Celery broker. REQUIRED (compose fails if empty).
# Generate with:  openssl rand -hex 32
PLANE_RMQ_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
# MinIO root password for Plane object storage. REQUIRED (compose fails if empty).
# Generate with:  openssl rand -hex 32
PLANE_MINIO_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# ============================================
# MATRIX/SYNAPSE CONFIGURATION (Human-in-the-Loop)
# ============================================
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_API_URL=http://localhost:8008
SYNAPSE_ADMIN_USER=admin
# Strong password for the bootstrapped Matrix admin account. Set a real one.
# Generate with:  openssl rand -hex 32
SYNAPSE_ADMIN_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
# MATRIX_BOT_TOKEN is auto-generated by init-admin-users.sh
MATRIX_BOT_TOKEN=
MATRIX_ADMIN_USER_ID=@admin:localhost
# REQUIRED for admin/bot bootstrap. Generate with:  openssl rand -hex 32
# Must MATCH registration_shared_secret in synapse/homeserver.yaml — the .ps1
# bootstrap signs the register HMAC with this .env value, while
# init-admin-users.sh reads the live value back out of homeserver.yaml. Open
# registration is OFF by default; shared-secret register still works.
# IMPORTANT — synapse/homeserver.yaml needs three secrets set, each unique:
#   - registration_shared_secret  -> set to the SAME value as this var below
#   - macaroon_secret_key         -> its own unique value (openssl rand -hex 32)
#   - form_secret                 -> its own unique value (openssl rand -hex 32)
# The bootstrap scripts now fail if SYNAPSE_REGISTRATION_SECRET is unset/empty.
SYNAPSE_REGISTRATION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ============================================
# BOOKSTACK CONFIGURATION (auto token via init-bookstack.ps1)
# ============================================
BOOKSTACK_URL=http://localhost:6875
BOOKSTACK_TOKEN=your-bookstack-api-token

# ============================================
# BOOKSTACK DATABASE CONFIGURATION
# ============================================
BOOKSTACK_DB_NAME=bookstack
BOOKSTACK_DB_USER=bookstack
# Strong passwords REQUIRED. Compose fails to start if unset/empty.
# Generate each with:  openssl rand -hex 32
BOOKSTACK_DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
BOOKSTACK_DB_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
# BookStack APP_KEY. REQUIRED (compose fails if empty). Must be a valid Laravel
# key. Generate with: docker run --rm lscr.io/linuxserver/bookstack:latest appkey
# or use:  base64:$(openssl rand -base64 32)
BOOKSTACK_APP_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ============================================
# CONTEXT7 CONFIGURATION (Tech Research)
# ============================================
CONTEXT7_API_KEY=your-context7-api-key

# ============================================
# WORKER CONFIGURATION
# ============================================
WORKER_IMAGE=turing-worker-base:latest
WORKER_TIMEOUT_MINUTES=15
ZOMBIE_CHECK_INTERVAL_MINUTES=5
MAX_WORKERS=5
EXECUTION_MODE=sequential

# Worker Health Monitoring
WORKER_HEARTBEAT_INTERVAL_MS=120000
WORKER_STUCK_THRESHOLD_MS=600000

# ============================================
# DOCTOR AGENT CONFIGURATION
# ============================================
# Doctor's fix execution is orchestrator-mediated: run_fix_script() maps a fix
# name onto an allow-listed action and POSTs it to {ORCHESTRATOR_URL}/remediation
# (the orchestrator performs it via Dockerode with audit + RBAC). The Doctor
# worker has no Docker socket and runs no local scripts.
#
# UNSAFE / OFF BY DEFAULT. When 'true', enables Doctor's patch_config_file tool
# to write config files in the worker's /workspace (absolute paths and `..`
# traversal are still rejected). The host repo/compose/.env are NOT mounted into
# the worker, so they are not reachable regardless. Leave unset/false in
# production — escalate host config changes to a human / DevOps instead.
# DOCTOR_ALLOW_CONFIG_PATCH=false

# ============================================
# GITHUB CONFIGURATION (Doctor Bug Reports)
# ============================================
# Doctor's GitHub escalation routes through the orchestrator's /gateway/github
# proxy using the worker's CONSUMER_TOKEN — no raw GitHub token in the worker.
# The real GitHub token lives in the orchestrator credential vault.
GITHUB_REPO=louisphamdev/turing-os
GITHUB_ISSUE_URL=https://github.com/louisphamdev/turing-os/issues/new

# ============================================
# ADMIN CONFIGURATION
# ============================================
ADMIN_USER=admin
# Strong password. Set a real one. Generate with:  openssl rand -hex 32
ADMIN_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# ============================================
# DOCKER CONFIGURATION
# ============================================
DOCKER_HOST=unix:///var/run/docker.sock
# On Docker Desktop for Windows, set DOCKER_SOCKET_PATH=//var/run/docker.sock if needed.
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_NETWORK=turing-os_turing_network

# ============================================
# ORCHESTRATOR CONFIGURATION
# ============================================
ORCHESTRATOR_URL=http://turing-orchestrator:3001
PORT=3001
AUTO_START_ROLES=po,pm,hr,doctor

# ============================================
# GATEWAY / SECURITY (REQUIRED — orchestrator refuses to boot without these)
# ============================================
# Gateway-only mode. Legacy direct-key fallback has been removed; the
# orchestrator generates per-worker consumer tokens and proxies every
# external call through the gateway.
GATEWAY_ENABLED=true

# Random 32+ char string. Used to sign worker consumer tokens.
# Generate with:  openssl rand -hex 32
JWT_SECRET=

# Random 32+ char string. Master key for AES-256-CBC credential vault.
# Generate with:  openssl rand -hex 32
VAULT_MASTER_KEY=

# Random 16+ char string. Required for admin-only endpoints
# (/gateway/tokens, /gateway/credentials, /webhooks/matrix slash commands,
# /webhooks/workers/:ticketId/recover). Passed as
# `Authorization: Bearer <ADMIN_API_TOKEN>`.
# Generate with:  openssl rand -hex 16
ADMIN_API_TOKEN=

# Random 32+ char shared secret. When set, the orchestrator requires every
# worker→orchestrator webhook (heartbeat, blocked, completed, worker-message,
# worker-inbox, checkpoint) to send `Authorization: Bearer <WORKER_INTERNAL_TOKEN>`.
# Workers read this from the same env (passed by docker-compose / spawn).
# Generate with:  openssl rand -hex 32
WORKER_INTERNAL_TOKEN=

# Shared secret for Plane webhook signing. REQUIRED in production: when unset,
# /webhooks/plane fails closed (503) because it can spawn/kill containers.
# When set, /webhooks/plane requires `X-Plane-Signature: sha256=<hex>` computed
# (HMAC-SHA256) over the EXACT raw request bytes.
# Configure the same value in Plane → Settings → Webhooks.
PLANE_WEBHOOK_SECRET=
# Override the signature header name if your Plane instance uses a custom one.
# PLANE_WEBHOOK_SIGNATURE_HEADER=x-plane-signature
# DEV-ONLY escape hatch: set to "true" to accept UNSIGNED Plane webhooks when
# PLANE_WEBHOOK_SECRET is unset (bypasses HMAC verification, logs a loud
# warning). NEVER enable this in production.
# ALLOW_UNSIGNED_PLANE_WEBHOOK=false

# Location of the PM state snapshot file (used for PM failover).
PM_STATE_PATH=/tmp/turing-pm-state.json

# ============================================
# NATS JetStream (internal message bus)
# ============================================
# Orchestrator dual-publishes admin->worker traffic to NATS in addition to
# the per-worker Matrix room (used for HITL admin chat).
NATS_ENABLED=true
NATS_URL=nats://nats:4222

# When true, workers subscribe to the NATS inbox subject. The HTTP poll
# path stays as a safety net; messages are deduplicated by eventId.
WORKER_NATS_SUBSCRIBE=true
