# ============================================
# LLM CONFIGURATION (required unless using Ollama)
# ============================================
# Provider options: openai, anthropic, minimax, ollama, custom
# For Ollama, LLM_API_KEY can be left blank.
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# MiniMax Example:
# LLM_PROVIDER=minimax
# LLM_API_KEY=your-minimax-api-key
# LLM_MODEL=Codex-MiniMax-M2.7

# Ollama Example:
# LLM_PROVIDER=ollama
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# ============================================
# TAIGA CONFIGURATION (auto-configured by init-admin-users.sh)
# ============================================
TAIGA_SCHEME=http
TAIGA_DOMAIN=localhost:9000
# TAIGA_API_KEY is auto-generated by init-admin-users.sh
TAIGA_API_KEY=
TAIGA_PROJECT_SLUG=turing-os
TAIGA_SECRET_KEY=change-me-in-production

POSTGRES_DB=taiga
POSTGRES_USER=taiga
POSTGRES_PASSWORD=taiga_password

RABBITMQ_USER=taiga
RABBITMQ_PASS=taiga_password
RABBITMQ_VHOST=taiga
RABBITMQ_ERLANG_COOKIE=secret-erlang-cookie

# ============================================
# MATRIX/SYNAPSE CONFIGURATION (Human-in-the-Loop)
# ============================================
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_API_URL=http://localhost:8008
SYNAPSE_ADMIN_USER=admin
SYNAPSE_ADMIN_PASSWORD=Admin123!
# MATRIX_BOT_TOKEN is auto-generated by init-admin-users.sh
MATRIX_BOT_TOKEN=
MATRIX_ADMIN_USER_ID=@admin:localhost
SYNAPSE_REGISTRATION_SECRET=change-me-in-production

# ============================================
# BOOKSTACK CONFIGURATION (auto token via init-bookstack.ps1)
# ============================================
BOOKSTACK_URL=http://localhost:6875
BOOKSTACK_TOKEN=your-bookstack-api-token

# ============================================
# BOOKSTACK DATABASE CONFIGURATION
# ============================================
BOOKSTACK_DB_NAME=bookstack
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=bookstack_pass
BOOKSTACK_DB_ROOT_PASSWORD=bookstack_root_pass
BOOKSTACK_APP_KEY=some_random_key_change_in_production

# ============================================
# CONTEXT7 CONFIGURATION (Tech Research)
# ============================================
CONTEXT7_API_KEY=your-context7-api-key

# ============================================
# WORKER CONFIGURATION
# ============================================
WORKER_IMAGE=turing-worker-base:latest
WORKER_TIMEOUT_MINUTES=15
ZOMBIE_CHECK_INTERVAL_MINUTES=5
MAX_WORKERS=5
EXECUTION_MODE=sequential

# Worker Health Monitoring
WORKER_HEARTBEAT_INTERVAL_MS=120000
WORKER_STUCK_THRESHOLD_MS=600000

# ============================================
# GITHUB CONFIGURATION (Doctor Bug Reports)
# ============================================
GITHUB_REPO=louisphamdev/turing-os
GITHUB_ISSUE_URL=https://github.com/louisphamdev/turing-os/issues/new

# ============================================
# ADMIN CONFIGURATION
# ============================================
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ============================================
# DOCKER CONFIGURATION
# ============================================
DOCKER_HOST=unix:///var/run/docker.sock
# On Docker Desktop for Windows, set DOCKER_SOCKET_PATH=//var/run/docker.sock if needed.
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_NETWORK=turing-os_turing_network

# ============================================
# ORCHESTRATOR CONFIGURATION
# ============================================
ORCHESTRATOR_URL=http://turing-orchestrator:3001

# ============================================
# GATEWAY / SECURITY (REQUIRED — orchestrator refuses to boot without these)
# ============================================
# Gateway is ON by default. Set GATEWAY_ENABLED=false only for legacy direct-key workers.
GATEWAY_ENABLED=true

# Random 32+ char string. Used to sign worker consumer tokens.
# Generate with:  openssl rand -hex 32
JWT_SECRET=

# Random 32+ char string. Master key for AES-256-CBC credential vault.
# Generate with:  openssl rand -hex 32
VAULT_MASTER_KEY=

# Random 16+ char string. Required for admin-only gateway endpoints
# (/gateway/tokens, /gateway/credentials, etc.). Passed as
# `Authorization: Bearer <ADMIN_API_TOKEN>`.
# Generate with:  openssl rand -hex 16
ADMIN_API_TOKEN=

# Location of the PM state snapshot file (used for PM failover).
PM_STATE_PATH=/tmp/turing-pm-state.json
PORT=3001
AUTO_START_ROLES=po,pm,hr,doctor