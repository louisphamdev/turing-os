# Taiga Configuration
TAIGA_SCHEME=http
TAIGA_DOMAIN=localhost:9000
SUBPATH=

# Database
POSTGRES_USER=taiga
POSTGRES_PASSWORD=taiga_password
POSTGRES_DB=taiga

# Secret Key
SECRET_KEY=taiga-secret-key-change-in-production

# Email (console = prints to stdout)
EMAIL_BACKEND=console
EMAIL_DEFAULT_FROM=noreply@taiga.local
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# RabbitMQ
RABBITMQ_USER=taiga
RABBITMQ_PASS=taiga_password
RABBITMQ_VHOST=taiga
RABBITMQ_ERLANG_COOKIE=secret-erlang-cookie

# Telemetry
ENABLE_TELEMETRY=False

# Public Registration
PUBLIC_REGISTER_ENABLED=True
